POSTGRES_PASSWORD=change-me
POSTGRES_DB=learnwohl
POSTGRES_USER=learnwohl
# Set these to the existing volume name and true when adopting an existing DB.
POSTGRES_VOLUME_NAME=learnwohl_learnwohl_pgdata
POSTGRES_VOLUME_EXTERNAL=false

# Auth and service-announcement email delivery. Keep credentials out of Git.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM=LearnWohl <contact@example.com>
# Shared email API tenants. Keep secrets out of Git; generate one strong secret
# per product and configure the same JSON in each caller's deployment.
# EMAIL_SERVICE_TENANTS={"flashkarte":{"secret":"...","fromAddress":"contact@example.com"},"notes-world":{"secret":"...","fromAddress":"notes@example.com"},"leguilde":{"secret":"...","fromAddress":"noreply@leguilde.art"}}
JWT_SECRET=change-me-to-a-long-random-string
NGINX_HOST=learnwohl.app
APP_URL=https://learnwohl.app
FLASHKARTE_LOG_PATH=./logs
APP_PORT=8096
MCP_PORT=8097
MCP_BASE_URL=https://learnwohl.app
MCP_PUBLIC_URL=https://learnwohl.app/mcp
# MCP OAuth (claude.ai connector)
MCP_OAUTH_CLIENT_ID=learnwohl-app-mcp
MCP_JWT_SECRET=change-me-to-a-long-random-string
# Exact-match allowlist of OAuth redirect URIs (comma-separated). Defaults to the
# known claude.ai/claude.com connector callbacks; only set this to override.
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# (Claude Code loopback callbacks are always allowed on top of this list;
#  other apps register themselves at /oauth/register.)
