CREATE TABLE progressEntity_new (
  card_id TEXT NOT NULL PRIMARY KEY,
  easiness REAL NOT NULL DEFAULT 2.5,
  interval_days REAL NOT NULL DEFAULT 0,
  repetitions INTEGER NOT NULL DEFAULT 0,
  due_at TEXT,
  last_reviewed_at TEXT,
  last_rating INTEGER
);

INSERT INTO progressEntity_new(card_id, easiness, interval_days, repetitions, due_at, last_reviewed_at, last_rating)
SELECT card_id, easiness, interval_days, repetitions, due_at, last_reviewed_at, last_rating
FROM progressEntity;

DROP TABLE progressEntity;
ALTER TABLE progressEntity_new RENAME TO progressEntity;
