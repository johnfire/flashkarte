CREATE TABLE cardEntity (
  id TEXT NOT NULL PRIMARY KEY,
  deck_id TEXT NOT NULL,
  front TEXT NOT NULL,
  back TEXT NOT NULL,
  category TEXT,
  position INTEGER NOT NULL DEFAULT 0,
  -- Spec 01: this card's own anchor, and (for diagnostic cards) the authored
  -- multiple-choice options as a JSON array of {text, goto}. Both NULL for
  -- ordinary cards. Cached whole-deck so remediation interludes resolve offline.
  label TEXT,
  options TEXT
);

upsertCard:
INSERT OR REPLACE INTO cardEntity(id, deck_id, front, back, category, position, label, options)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteCardsForDeck:
DELETE FROM cardEntity WHERE deck_id = ?;

selectCardsForDeck:
SELECT * FROM cardEntity WHERE deck_id = ? ORDER BY position;

selectCardByLabel:
SELECT * FROM cardEntity WHERE deck_id = ? AND label = ? LIMIT 1;
