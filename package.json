{
  "name": "flashkarte",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/security/apply-dependency-patches.cjs",
    "test": "npm run test:dependency-security && npm run test --workspaces --if-present",
    "test:dependency-security": "node --test scripts/security/dependency-remediation.test.cjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,tsx}\"",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "overrides": {
    "hono": "^4.13.5",
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.6",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0"
  }
}
