{
  "name": "@flashkarte/server",
  "version": "0.1.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "migrate": "ts-node src/db/migrate.ts"
  },
  "dependencies": {
    "@flashkarte/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.1",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
