          ]
        }
      ],
      "options": [
        {
          "correct": true,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Each vector is looked up without looking at the neighbouring tokens, so it cannot reflect the context"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Attention is what brings the context in."
