              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "The ID was fixed by the tokenizer."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "prompt": [
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "The embedding of a token is looked up from a table. Why is that not enough on its own?"
