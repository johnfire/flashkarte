              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The vectors have different lengths for different tokens"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Every token's vector has the same length, d_model."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The vectors change at random each time"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "A lookup gives the same vector every time."
                }
              ]
            }
          ]
        }
      ],
      "teaches": ["context-blind"],
      "covers": ["attention-gist"],
      "variants": [
