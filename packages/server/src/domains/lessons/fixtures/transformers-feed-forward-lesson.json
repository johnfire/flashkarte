              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The FFN does not depend on the number of tokens."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "W₁ is d_ff × d_ff, and W₂ is d_model × d_model"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The matrices connect d_model to d_ff and back."
                }
              ]
            }
          ]
        }
      ],
