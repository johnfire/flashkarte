    },
    {
      "prompt": [
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Why use several heads instead of one large head?"
            }
          ]
        }
      ],
      "options": [
        {
          "correct": true,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Each head can learn a different attention pattern in a different subspace, in parallel, at about the same cost"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "One softmax head would have to average the patterns."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "To make the model skip most of the tokens"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Every position is still updated."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "To reduce the number of parameters to almost none"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The layer still has 4 · d_model² parameters."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "To let each position see the tokens that come after it"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Heads do not change which positions can be seen."
                }
              ]
            }
          ]
        }
      ],
      "teaches": ["one-head-limit", "why-several"],
      "covers": ["multi-head-attention"],
      "variants": [
        {
          "prompt": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "What limitation of a single head do several heads address?"
                }
              ]
            }
          ],
          "options": [
            {
              "correct": true,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "One softmax distribution has to average all the different patterns a position might need"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Several heads can each keep their own pattern."
                    }
                  ]
                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A single head cannot compute a dot product"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "It can."
                    }
                  ]
                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A single head cannot handle more than 8 tokens"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "There is no such limit."
                    }
                  ]
                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A single head has no values"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Every head has queries, keys and values."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
