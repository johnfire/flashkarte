                  ]
                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Both add the same"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "They give errors of about 0.105 and 4.605."
                    }
                  ]
                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Neither, because only the last position counts"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "The loss is averaged over all the positions."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "prompt": [
