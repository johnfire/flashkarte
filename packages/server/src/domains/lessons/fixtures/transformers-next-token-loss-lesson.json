              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "They are equal, because both are probabilities"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
