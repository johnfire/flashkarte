                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Position 1, because 0.9 is the larger probability"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A larger probability on the true token gives a smaller error."
