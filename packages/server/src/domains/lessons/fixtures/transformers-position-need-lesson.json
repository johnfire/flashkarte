              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "To make attention run faster"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "It is about meaning, not speed."
