    {
      "prompt": [
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Softmax in attention is taken along which axis of the n × n score matrix?"
            }
          ]
        }
      ],
      "options": [
        {
          "correct": true,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Along each row: across the keys, separately for each query"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Each row then adds up to 1."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Along each column: across the queries, separately for each key"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The columns do not have to add up to 1."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Over the whole matrix as one distribution"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Each query gets its own distribution."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "It is not applied to the scores"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Softmax turns the scores into weights."
                }
              ]
            }
          ]
        }
      ],
