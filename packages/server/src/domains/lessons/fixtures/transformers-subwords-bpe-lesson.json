      ],
      "variants": [
        {
          "prompt": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Splitting every word into single characters makes n larger. Why does that matter so much?"
                }
              ]
            }
          ],
          "options": [
            {
              "correct": true,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Attention cost grows as n², so a longer sequence is much more expensive"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Double the tokens and the attention work roughly quadruples."
                    }
                  ]
                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Longer sequences make the vocabulary bigger"
                    }
                  ]
                }
              ],
              "reason": [
