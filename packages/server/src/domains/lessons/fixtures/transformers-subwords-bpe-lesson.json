                  "spans": [
                    {
                      "text": "The context window gets shorter"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "The window is a fixed limit in tokens; more tokens simply fill it sooner."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
