          "correct": true,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "It divides the logits by T before softmax: T above 1 flattens the distribution, T below 1 sharpens it"
                }
              ]
            }
          ],
          "reason": [
