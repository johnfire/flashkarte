                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The change is made to the logits, before softmax, and the result still adds up to 1."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
