              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Temperature is applied when choosing a token. The network's weights do not change."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "It shrinks the vocabulary to T tokens"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Temperature does not remove tokens. It reshapes their probabilities."
                }
              ]
            }
          ]
        }
      ],
