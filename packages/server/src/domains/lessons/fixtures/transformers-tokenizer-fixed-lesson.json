          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Because gradients only flow forward"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Backpropagation flows backward through the network."
                }
              ]
            }
          ]
        }
      ],
