    {
      "prompt": [
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "Why can't gradients flow into the tokenizer's segmentation?"
            }
          ]
        }
      ],
      "options": [
        {
          "correct": true,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Token IDs are discrete: choosing how to split text is not a smooth, differentiable operation"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Gradients describe smooth changes, and there is nothing in between two ways of splitting."
                }
