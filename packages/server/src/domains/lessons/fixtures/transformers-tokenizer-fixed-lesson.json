          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Because the gradients are always zero at the embedding table"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The looked-up embedding rows do receive gradients."
                }
              ]
            }
          ]
        },
