                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Nothing about meaning is given at the input; only the IDs."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "prompt": [
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "What is the vocabulary of a language model?"
            }
          ]
        }
      ],
      "options": [
        {
          "correct": true,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The complete, fixed list of tokens it can read and write"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "That is the definition: a fixed list, and its size is V."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Every word in the English language"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The vocabulary is a list of tokens, which can be pieces of words, and it is fixed at a chosen size."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The words used in the current conversation"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The vocabulary does not depend on the conversation."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "A list that grows as the model reads more text"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The vocabulary is fixed. It does not grow as the model reads."
                }
              ]
            }
          ]
        }
      ],
      "teaches": ["vocab"],
      "covers": ["vocabulary"],
      "variants": [
        {
