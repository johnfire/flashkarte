                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "70 billion layers"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "A model has tens of layers, not billions. The parameters are the numbers inside them."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "prompt": [
        {
          "type": "paragraph",
          "spans": [
            {
              "text": "During inference, what happens to the parameters?"
            }
          ]
        }
      ],
      "options": [
        {
          "correct": true,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "They stay frozen: the network uses them unchanged to produce output"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Only training adjusts them."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "They are adjusted a little after every reply"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "That is what training does. Inference leaves them alone."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "They are deleted once the reply is finished"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "The parameters are the model. They stay for the next prompt."
                }
              ]
            }
          ]
        },
        {
          "correct": false,
          "blocks": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "They are doubled to make the output longer"
                }
              ]
            }
          ],
          "reason": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "text": "Nothing about them changes during inference."
                }
              ]
            }
          ]
        }
      ],
      "teaches": ["inference"],
      "covers": ["training-vs-inference", "parameters"],
      "variants": [
        {
          "prompt": [
            {
              "type": "paragraph",
