                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Vocabularies have tens of thousands to a few hundred thousand tokens."
                    }
                  ]
                }
              ]
            },
            {
              "correct": false,
              "blocks": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "70 billion texts it was trained on"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "The count is of numbers inside the network, not of training texts."
                    }
