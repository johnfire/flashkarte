                    {
                      "text": "The network produces output"
                    }
                  ]
                }
              ],
              "reason": [
                {
                  "type": "paragraph",
                  "spans": [
                    {
                      "text": "Both produce output. Only training then adjusts the parameters."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
